{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "docker-build",
			"label": "docker-build",
			"platform": "python",
			"dockerBuild": {
				"tag": "prerob:latest",
				"dockerfile": "${workspaceFolder}/Dockerfile",
				"context": "${workspaceFolder}",
				"pull": true
			}
		},
		{
			"type": "shell",
			"label": "docker-run: debug",
			"command": "docker-compose up --abort-on-container-exit",
			"problemMatcher": []
		}
	]
}